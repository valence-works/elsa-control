{
  "Database": {
    "Provider": "SqlServer"
  },
  "Authentication": {
    "ControlIdentity": {
      "Provider": "GenericOidc",
      "Authority": "",
      "Audience": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectUri": "/api/auth/callback",
      "PostLogoutRedirectUri": "/admin",
      "RequireHttpsMetadata": true
    },
    "Admin": {
      "AllowAuthenticatedCustomerSession": false
    },
    "WorkspaceTrustedHeaders": {
      "Enabled": false
    }
  },
  "Sync": {
    "Scheduled": {
      "Enabled": true,
      "Interval": "01:00:00"
    }
  },
  "Deployment": {
    "QueueWorker": {
      "Enabled": false
    },
    "WebhookDispatch": {
      "Enabled": false,
      "BatchSize": 25,
      "PollInterval": "00:00:15",
      "NotificationPath": "/api/elsa-control/deployment-command-notifications"
    }
  }
}
