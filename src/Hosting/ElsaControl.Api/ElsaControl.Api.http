@baseUrl = http://localhost:5220
@apiKey = local-dev-key
@builderClientApiKey = builder-dev-key
@controlJwt = paste-token-from-scripts-create-local-elsa-control-jwt-here
@sourceId = 00000000-0000-0000-0000-000000000000
@syncRunId = 00000000-0000-0000-0000-000000000000
@packageId = Elsa.Email
@packageVersion = 1.0.0
@featureId = email
@workspaceId = 00000000-0000-0000-0000-000000000000
@runtimeConfigurationId = 00000000-0000-0000-0000-000000000000

### Root
GET {{baseUrl}}/

### Health
GET {{baseUrl}}/health

### OpenAPI document
GET {{baseUrl}}/openapi/v1.json

### Public: list packages
GET {{baseUrl}}/api/packages

### Public: package details
GET {{baseUrl}}/api/packages/{{packageId}}

### Public: package versions
GET {{baseUrl}}/api/packages/{{packageId}}/versions

### Public: package version details
GET {{baseUrl}}/api/packages/{{packageId}}/versions/{{packageVersion}}

### Public: list features
GET {{baseUrl}}/api/features

### Public: feature details
GET {{baseUrl}}/api/features/{{featureId}}

### Public: compatibility check
POST {{baseUrl}}/api/compatibility/check
Content-Type: application/json

{
  "elsaVersion": "3.0.0",
  "dockerImageVersion": "3.0.0",
  "packages": [
    {
      "packageId": "{{packageId}}",
      "version": "{{packageVersion}}"
    }
  ],
  "features": [
    "{{featureId}}"
  ]
}

### Runtime Builder: catalog with runtime images
GET {{baseUrl}}/api/builder/catalog

### Runtime Builder: plan intent
POST {{baseUrl}}/api/builder/plan
Content-Type: application/json

{
  "intent": {
    "image": {
      "slug": "elsa-pro-combined",
      "tag": "latest",
      "hostPort": 8080,
      "envOverrides": {}
    },
    "packages": [],
    "packageSources": [],
    "infrastructure": [],
    "localPackages": {
      "enabled": false,
      "directoryPath": "packages"
    }
  }
}

### Runtime Builder: generate deployment bundle
POST {{baseUrl}}/api/builder/bundle
X-Api-Key: {{builderClientApiKey}}
Content-Type: application/json

{
  "image": {
    "slug": "elsa-pro-combined",
    "tag": "latest",
    "hostPort": 8080,
    "envOverrides": {}
  },
  "packages": [],
  "packageSources": [],
  "infrastructure": [],
  "localPackages": {
    "enabled": false,
    "directoryPath": "packages"
  }
}

### Workspace: current account and workspaces
GET {{baseUrl}}/api/me/workspaces
Authorization: Bearer {{controlJwt}}

### Workspace: current memberships without provisioning
GET {{baseUrl}}/api/me/workspace-memberships
Authorization: Bearer {{controlJwt}}

### Workspace: plan runtime builder intent
POST {{baseUrl}}/api/workspaces/{{workspaceId}}/builder/plan
Authorization: Bearer {{controlJwt}}
Content-Type: application/json

{
  "intent": {
    "image": {
      "slug": "elsa-pro-combined",
      "tag": "latest",
      "hostPort": 8080,
      "envOverrides": {}
    },
    "packages": [],
    "packageSources": [],
    "infrastructure": [],
    "localPackages": {
      "enabled": false,
      "directoryPath": "packages"
    }
  }
}

### Workspace: list runtime configurations
GET {{baseUrl}}/api/workspaces/{{workspaceId}}/runtime-configurations
Authorization: Bearer {{controlJwt}}

### Workspace: create runtime configuration
POST {{baseUrl}}/api/workspaces/{{workspaceId}}/runtime-configurations
Authorization: Bearer {{controlJwt}}
Content-Type: application/json

{
  "name": "Production Elsa Runtime",
  "description": "Combined runtime",
  "intent": {
    "image": {
      "slug": "elsa-pro-combined",
      "tag": "latest",
      "hostPort": 8080,
      "envOverrides": {}
    },
    "packages": [],
    "packageSources": [],
    "infrastructure": [],
    "localPackages": {
      "enabled": false,
      "directoryPath": "packages"
    }
  }
}

### Workspace: create runtime configuration version
POST {{baseUrl}}/api/workspaces/{{workspaceId}}/runtime-configurations/{{runtimeConfigurationId}}/versions
Authorization: Bearer {{controlJwt}}

### Workspace: generate bundle from saved runtime configuration
POST {{baseUrl}}/api/workspaces/{{workspaceId}}/runtime-configurations/{{runtimeConfigurationId}}/bundle
Authorization: Bearer {{controlJwt}}

### Admin: list package sources
GET {{baseUrl}}/api/admin/sources
X-Api-Key: {{apiKey}}

### Admin: create package source
# approvalPolicy: 0 = AutoApprove, 1 = Manual
POST {{baseUrl}}/api/admin/sources
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "name": "NuGet",
  "url": "https://api.nuget.org/v3/index.json",
  "enabled": true,
  "includePatterns": [
    "Elsa.Email"
  ],
  "excludePatterns": [
    "Elsa.Experimental.*"
  ],
  "approvalPolicy": 1
}

### Admin: update package source
# Replace @sourceId with the ID returned by "create package source".
PUT {{baseUrl}}/api/admin/sources/{{sourceId}}
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "name": "NuGet",
  "url": "https://api.nuget.org/v3/index.json",
  "enabled": true,
  "includePatterns": [
    "Elsa.Email"
  ],
  "excludePatterns": [
    "Elsa.Experimental.*"
  ],
  "approvalPolicy": 1
}

### Admin: delete package source
# Replace @sourceId with the source ID to delete.
DELETE {{baseUrl}}/api/admin/sources/{{sourceId}}
X-Api-Key: {{apiKey}}

### Admin: trigger sync for all enabled sources
POST {{baseUrl}}/api/admin/sync
X-Api-Key: {{apiKey}}

### Admin: trigger sync for one source
POST {{baseUrl}}/api/admin/sync/sources/{{sourceId}}
X-Api-Key: {{apiKey}}

### Admin: trigger sync for one package
# Currently returns 400 until package source ownership is known.
POST {{baseUrl}}/api/admin/sync/packages/{{packageId}}
X-Api-Key: {{apiKey}}

### Admin: list sync runs
GET {{baseUrl}}/api/admin/sync-runs
X-Api-Key: {{apiKey}}

### Admin: sync run details
GET {{baseUrl}}/api/admin/sync-runs/{{syncRunId}}
X-Api-Key: {{apiKey}}

### Admin: preview sync run cleanup before cutoff
GET {{baseUrl}}/api/admin/sync-runs/deletion-preview?completedBefore=2026-05-01T00%3A00%3A00Z
X-Api-Key: {{apiKey}}

### Admin: delete one sync run
DELETE {{baseUrl}}/api/admin/sync-runs/{{syncRunId}}
X-Api-Key: {{apiKey}}

### Admin: delete sync runs completed before cutoff
DELETE {{baseUrl}}/api/admin/sync-runs?completedBefore=2026-05-01T00%3A00%3A00Z
X-Api-Key: {{apiKey}}

### Admin: list packages, including hidden or invalid states
GET {{baseUrl}}/api/admin/packages
X-Api-Key: {{apiKey}}

### Admin: package review details
GET {{baseUrl}}/api/admin/packages/{{packageId}}
X-Api-Key: {{apiKey}}

### Admin: approve package
POST {{baseUrl}}/api/admin/packages/{{packageId}}/approve
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "reason": "Approved for catalog listing."
}

### Admin: reject package
POST {{baseUrl}}/api/admin/packages/{{packageId}}/reject
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "reason": "Rejected during catalog review."
}

### Admin: approve package version
POST {{baseUrl}}/api/admin/packages/{{packageId}}/versions/{{packageVersion}}/approve
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "reason": "Version approved for catalog listing."
}

### Admin: reject package version
POST {{baseUrl}}/api/admin/packages/{{packageId}}/versions/{{packageVersion}}/reject
X-Api-Key: {{apiKey}}
Content-Type: application/json

{
  "reason": "Version rejected during catalog review."
}

### Admin: package version validation details
GET {{baseUrl}}/api/admin/packages/{{packageId}}/versions/{{packageVersion}}/validation
X-Api-Key: {{apiKey}}
