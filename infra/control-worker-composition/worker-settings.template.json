{
  "$comment": "Production App Service settings that enable the managed-instance lifecycle and Azure provider workers in the Control API. Every ${NAME} is resolved from worker-settings.parameters.production.json by scripts/render-worker-settings.py; literals are governed constants. Tool paths and TemplateRoot come from the API image (Dockerfile ENV) and are deliberately absent.",
  "Deployment__ElsaInstanceLifecycle__Enabled": "true",
  "Deployment__ElsaInstanceLifecycle__PollInterval": "00:00:05",
  "Deployment__AzureProvider__WorkerEnabled": "true",
  "Deployment__AzureProvider__PollInterval": "00:00:05",
  "Deployment__AzureProvider__BatchSize": "10",
  "Deployment__AzureProvider__InstanceLifecycle__Enabled": "true",
  "Deployment__AzureProvider__Runner__Enabled": "true",
  "Deployment__AzureProvider__Runner__DisposableProofMode": "false",
  "Deployment__AzureProvider__Runner__AzureCliClientId": "${ProvisionerClientId}",
  "Deployment__AzureProvider__Runner__SqlBootstrapObjectId": "${ProvisionerPrincipalId}",
  "Deployment__AzureProvider__Runner__SqlBootstrapLogin": "${ProvisionerIdentityName}",
  "Deployment__AzureProvider__Runner__SqlBootstrapIp": "${SqlBootstrapIp}",
  "Deployment__AzureProvider__Runner__RuntimeAdminUsername": "${RuntimeAdminUsername}",
  "Deployment__AzureProvider__Runner__ReleaseFeedServiceIndex": "${ReleaseFeedServiceIndex}",
  "Deployment__AzureProvider__Runner__Owner": "elsa-control",
  "Deployment__AzureProvider__Runner__RegistryAuthorityMode": "Narrow",
  "Deployment__AzureProvider__Runner__RegistryDeploymentMetadataRoleDefinitionId": "${RegistryDeploymentMetadataRoleDefinitionId}",
  "Deployment__AzureProvider__Runner__RegistryDeploymentMetadataRoleAssignmentId": "${RegistryDeploymentMetadataRoleAssignmentId}",
  "Deployment__AzureProvider__Runner__RegistryRoleAdministrationAssignmentId": "${RegistryRoleAdministrationAssignmentId}",
  "Deployment__AzureProvider__Runner__TargetScope__SubscriptionId": "${WorkloadSubscriptionId}",
  "Deployment__AzureProvider__Runner__TargetScope__ResourceGroupName": "${WorkloadResourceGroupName}",
  "Deployment__AzureProvider__Runner__TargetScope__RegistrySubscriptionId": "${RegistrySubscriptionId}",
  "Deployment__AzureProvider__Runner__TargetScope__RegistryResourceGroupName": "${RegistryResourceGroupName}",
  "Deployment__AzureProvider__Runner__TargetScope__RegistryName": "${RegistryName}",
  "Deployment__AzureProvider__Runner__TargetScope__Location": "westeurope",
  "Deployment__AzureProvider__Secrets__0__Name": "database:connectionstring",
  "Deployment__AzureProvider__Secrets__0__Reference": "secret://azure-managed/sql-connection",
  "Deployment__AzureProvider__Secrets__1__Name": "identity:signingkey",
  "Deployment__AzureProvider__Secrets__1__Reference": "secret://azure-managed/identity-signing-key",
  "Deployment__AzureProvider__Secrets__2__Name": "admin:password",
  "Deployment__AzureProvider__Secrets__2__Reference": "secret://azure-managed/admin-password",
  "RuntimeBuilder__InstancePlans__DefaultEgress": "unrestricted",
  "ControlPlane__Origin": "${ControlPlaneOrigin}"
}
